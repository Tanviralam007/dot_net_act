
@{
    ViewBag.Title = "Details";
}

<h2>Product Details</h2>
<a href="/Product/ProductList" class="btn btn-primary">Back To Product List</a>
<br /> <br />

<table class="table table-bordered" style="width: 400px;">
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>@Model.Price</td>
    </tr>

    <tr>
        <th>Quantity</th>
        <td>@Model.Qty</td>
    </tr>
</table>