
@{
    ViewBag.Title = "Details";
}

<h2>Student Details</h2>

<table class="table table-bordered" style="width: 400px;">
    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Gender</th>
        <td>@Model.Gender</td>
    </tr>
</table>

<a href="/Student/List" class="btn btn-secondary">Back to List</a>
