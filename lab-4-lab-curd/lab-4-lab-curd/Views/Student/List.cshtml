
@{
    ViewBag.Title = "List";
}

<h2>Students List</h2>

@if (TempData["Msg"] != null)
{
    <p class="alert alert-info">@TempData["Msg"]</p>
}

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Gender</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Gender</td>
            <td>
                <a href="/Student/Details/@item.Id">Details</a>
                <a href="/Student/Edit/@item.Id">Edit</a>
                <a href="/Student/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>